flowchart LR
  subgraph User["User / CI"]
    U[QA Engineer or Webhook]
  end

  subgraph UI["Web UI"]
    D[Dashboard / Insights]
    W[Trigger Wizard]
    H[Heatmap]
  end

  subgraph Hub["Execution Hub"]
    O[Orchestration Service]
    A[Aggregator & Tag Parser]
