# DarkKnight Control API — see DarkKnight repo: openapi.yaml, README “QA Dashboard integration handoff”
# Clone: https://gitlab-ee.mpokket.org/quality-assurance/Performance_Testing/DarkKnight.git

# Base URL for browser calls. If unset in dev, the UI uses same-origin /dark-knight (Vite proxies to http://localhost:8080).
# For direct calls, allow CORS for this app origin (this project uses Vite port 5174 by default; include http://localhost:5173 if you use that port).
# VITE_DARKKNIGHT_API_BASE=http://localhost:8080

# Optional: when DarkKnight runs with API_KEY, set the same value (exposed to the browser bundle).
# VITE_DARKKNIGHT_API_KEY=dev-shared-secret
